# syntax=docker/dockerfile:1.7
# ----------------------------------------------------------------------------
# Minimal Tor hidden-service container for IceQ.
#
# Based on Alpine's tor package (actively maintained). Runs a single
# v3 hidden service with the keypair persisted in the tor_keys volume.
# Non-root operation: tor switches to the `tor` user after binding
# its control port.
#
# This replaces the unmaintained goldy/tor-hidden-service image
# (last pushed 2023-01-08). Tor is disabled by default — enable
# with `docker compose --profile tor up`.
#
# arm64 / Apple Silicon: supported via the alpine multi-arch image.
# ----------------------------------------------------------------------------

FROM alpine:3.24

RUN apk add --no-cache \
    tor~=0.4.8 \
    && rm -rf /var/cache/apk/*

# tor runs as the `tor` user created by the apk package.
# DataDir must be writable by tor; the volume mount will
# provide the persistent keypair directory.
RUN mkdir -p /var/lib/tor/hidden_service \
    && chown -R tor:tor /var/lib/tor \
    && chmod 700 /var/lib/tor/hidden_service

VOLUME ["/var/lib/tor/hidden_service"]

USER tor

# Tor is configured at runtime via the torrc file mounted
# or generated by the entrypoint. The control port is not
# exposed outside the container.
ENTRYPOINT ["tor"]
CMD ["-f", "/etc/tor/torrc"]
