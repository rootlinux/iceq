# IceQ environment variable template.
# Copy to .env.local and fill in real values before running `docker compose up`.
# .env.local is gitignored — never commit real secrets.

# ── Postgres ─────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=iceq

# ICEQ_PG_DSN is the DSN the Go services use to reach Postgres.
# docker-compose's `environment:` block cannot interpolate env_file
# values, so the DSN has to be set here (and copied to .env.local
# verbatim). The placeholders below MUST be replaced with the same
# values you set for POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB.
ICEQ_PG_DSN=postgres://postgres:changeme@postgres:5432/iceq?sslmode=disable

# ── Redis ─────────────────────────────────────────────────────────────────────
ICEQ_REDIS_PASSWORD=changeme

# ── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=changeme
MINIO_BROWSER_URL=http://localhost:9001

# ── JWT (shared root of trust across all services) ────────────────────────────
# MUST be exactly the output of: openssl rand -hex 32  (64 hex chars / 32 bytes)
# Any other value — including the placeholder below — is rejected at process
# start with "jwt: ICEQ_JWT_SECRET is too weak". The empty default is the
# point: shipping a known-good secret in a template file is a CVSS-9.1
# vulnerability, so we ship a placeholder that fails the boot check.
ICEQ_JWT_SECRET=__REPLACE_ME_run_openssl_rand_hex_32__

# ── CORS (auth-service; browser-facing origin whitelist) ─────────────────────
# Comma-separated list of allowed origins.
# Example: https://app.iceq.example.com,https://www.iceq.example.com
ICEQ_ALLOWED_ORIGINS=https://localhost,https://iceq.space,https://www.iceq.space

# ── Message retention ────────────────────────────────────────────────────────
# Optional Scylla TTL for encrypted message rows, in seconds. 0 keeps the
# current durable-history behavior. Example: 604800 deletes rows after 7 days.
ICEQ_MESSAGE_TTL_SECONDS=0

# ── Git SHA (injected at build time) ─────────────────────────────────────────
GIT_SHA=dev

# ── Tor hidden service ────────────────────────────────────────────────────────
# TOR_SERVICE_VERSION=3 (do not change; v3 gives 56-char .onion addresses).
# The .onion address is auto-generated on first boot by the Tor container and
# stored in the `tor_keys` Docker volume. Retrieve it with:
#   ./deploy/scripts/onion-address.sh
#
# Optional Onion-Location header value. This is only known after the first Tor
# boot generates the v3 address. It should look like http://<v3>.onion.
# Use the script output and keep this on onion; do not point it at clearnet.
#ICEQ_ONION_LOCATION=http://<v3>.onion
#
# Optional override (only if your Tor image variant supports it):
#   TOR_HTTPS=false   # default. If true, Tor forwards to Caddy over HTTPS.
#                     # IceQ's goldy/tor-hidden-service config uses plain HTTP.
#TOR_SERVICE_VERSION=3
#TOR_HTTPS=false
