# Profile-scoped internal edge for the optional Tor hidden service.
# This file is mounted only by the `caddy-tor` service under `--profile tor`.
# The Tor container terminates the onion transport and forwards plain HTTP on
# the private Docker bridge; this edge then reuses the default Caddy HTTPS
# route, rate-limit, logging, and response-header policy.

{
    admin off
}

:80 {
    handle /edge-health {
        respond "OK" 200
    }

    reverse_proxy https://caddy:443 {
        header_up Host iceq.space
        transport http {
            tls
            tls_server_name iceq.space
            # The internal hop verifies routing/policy rather than public PKI.
            # Public TLS remains terminated by the default Caddy edge.
            tls_insecure_skip_verify
        }
    }
}
