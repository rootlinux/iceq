{
  "name": "iceq-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "IceQ web client — E2EE messenger frontend (React + Vite + TypeScript)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "node --import tsx --test tests/*.test.mjs tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium webkit",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "icons": "node web/scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@privacyresearch/libsignal-protocol-protobuf-ts": "0.0.9",
    "@privacyresearch/libsignal-protocol-typescript": "^0.0.16",
    "jsqr": "^1.4.0",
    "protobufjs": "7.6.5",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.4.19",
    "fake-indexeddb": "^6.2.5",
    "postcss": "^8.4.39",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.6",
    "tsx": "^4.23.0",
    "typescript": "^5.5.3",
    "vite": "^8.1.4"
  }
}
